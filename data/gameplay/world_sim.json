{
  // Đồng hồ: thời gian THẬT (giây) cho một ngày trong game. 2400 s = 40 phút.
  "clock": { "day_length_real_s": 2400, "start_hour": 8.0 },
  // Mật độ người đi bộ theo giờ (0..23), nhân với humans_per_chunk.
  "pedestrian_density_by_hour": [0.1, 0.05, 0.05, 0.05, 0.1, 0.3, 0.6, 0.9, 1.0, 0.8, 0.7, 0.9,
                                 1.0, 0.9, 0.7, 0.7, 0.8, 1.0, 1.0, 0.9, 0.7, 0.5, 0.3, 0.2],
  // Giờ ăn: nguồn thức ăn hồi nhanh hơn (người vứt đồ thừa).
  "meal_hours": [[7, 9], [11, 13], [17, 20]], "meal_food_regen_mult": 3.0,
  "weather": {
    "seed_salt": 7,
    "transition_s": 90,
    "states": {
      "clear":  { "min_s": 300, "max_s": 900, "next": { "cloudy": 6, "fog": 1 }, "visibility": 1.0, "scent": 1.0, "move": 1.0, "pedestrians": 1.0 },
      "cloudy": { "min_s": 240, "max_s": 600, "next": { "clear": 4, "rain": 4, "fog": 1 }, "visibility": 0.9, "scent": 1.0, "move": 1.0, "pedestrians": 0.9 },
      "rain":   { "min_s": 180, "max_s": 480, "next": { "cloudy": 5, "storm": 2 }, "visibility": 0.7, "scent": 0.6, "move": 0.95, "pedestrians": 0.5 },
      "fog":    { "min_s": 180, "max_s": 420, "next": { "clear": 3, "cloudy": 2 }, "visibility": 0.45, "scent": 1.2, "move": 1.0, "pedestrians": 0.7 },
      "storm":  { "min_s": 120, "max_s": 300, "next": { "rain": 1 }, "visibility": 0.5, "scent": 0.4, "move": 0.9, "pedestrians": 0.2 }
    }
  },
  "events": {
    "check_interval_s": 45,
    "max_active": 2,
    "spawn_min_m": 25, "spawn_max_m": 90,
    "defs": {
      "lost_puppy":    { "weight": 3, "cooldown_s": 600, "duration_s": 300, "districts": ["residential", "park"], "hours": [6, 21] },
      "food_hotspot":  { "weight": 4, "cooldown_s": 300, "duration_s": 180, "districts": ["downtown", "residential", "industrial"], "hours": [0, 24] },
      "dog_conflict":  { "weight": 2, "cooldown_s": 480, "duration_s": 120, "districts": ["industrial", "residential"], "hours": [0, 24] },
      "rescue_signal": { "weight": 2, "cooldown_s": 600, "duration_s": 240, "districts": ["industrial", "downtown"], "hours": [0, 24] },
      "area_closure":  { "weight": 1, "cooldown_s": 900, "duration_s": 240, "districts": ["downtown"], "hours": [7, 20] }
    }
  }
}
