# Mẫu cấu hình — KHÔNG chứa giá trị thật. Sao chép thành .env (đã .gitignore) và điền.
DATABASE_URL=postgresql://pawbound:CHANGE_ME@127.0.0.1:54329/pawbound?schema=public
# Database cho test e2e/integration: test tự tạo database TẠM trên server này rồi xóa (role cần quyền CREATEDB)
DATABASE_URL_TEST=postgresql://pawbound:CHANGE_ME@127.0.0.1:54329/pawbound_test?schema=public
PORT=3000
# Bí mật ký access token JWT (HS256): chuỗi ngẫu nhiên >= 32 ký tự
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_S=2592000
# Khóa bí mật Ed25519 ký session ticket (định dạng libsodium base64url, tạo bằng: pawbound net keygen)
TICKET_SK_FILE=../config/dev_keys/ticket_sk.b64
TICKET_TTL_S=60
# Token dịch vụ cho game server gọi API nội bộ (/internal/v1): chuỗi ngẫu nhiên dài
INTERNAL_SERVICE_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
