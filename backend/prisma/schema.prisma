// PAWBOUND — schema PostgreSQL (Phase 11). Xem docs/architecture/database-design.md.
// Quy ước: khóa chính UUID; numericId (BigInt tự tăng) cho game server (ticket dùng id số u64).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

enum Role {
  PLAYER
  ADMIN
}

enum ServerStatus {
  ONLINE
  DRAINING
  OFFLINE
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  numericId      BigInt         @unique @default(autoincrement())
  email          String         @unique
  passwordHash   String
  status         UserStatus     @default(ACTIVE)
  role           Role           @default(PLAYER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  profile        PlayerProfile?
  characters     DogCharacter[]
  refreshTokens  RefreshToken[]
  sessions       GameSession[]
  // Phase 12
  chatMutedUntil DateTime?
  friendsOut     Friendship[]   @relation("FriendRequester")
  friendsIn      Friendship[]   @relation("FriendAddressee")
  blocking       UserBlock[]    @relation("Blocker")
  blockedBy      UserBlock[]    @relation("Blocked")
  partyMember    PartyMember?
  guildMember    GuildMember?
  chatMessages   ChatMessage[]
  notifications  Notification[]
  // Phase 13
  paymentOrders  PaymentOrder[]
  entitlements   Entitlement[]
  wallet         Wallet?
  cosmetics      UserCosmetic[]
}

// Refresh token chỉ lưu HASH (SHA-256), không lưu bản gốc. familyId: chuỗi xoay vòng; dùng lại token đã xoay -> thu hồi cả họ.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  familyId     String    @db.Uuid
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @db.Uuid
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model PlayerProfile {
  userId           String   @id @db.Uuid
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String
  displayNameLower String   @unique
  locale           String   @default("vi")
  createdAt        DateTime @default(now())
}

model DogCharacter {
  id           String               @id @default(uuid()) @db.Uuid
  numericId    BigInt               @unique @default(autoincrement())
  userId       String               @db.Uuid
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  breedId      String
  level        Int                  @default(1)
  xp           Int                  @default(0)
  // Trạng thái game (vị trí, chỉ số, túi đồ) do game server ghi qua API nội bộ.
  state        Json                 @default("{}")
  stateVersion Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?
  appearance   CharacterAppearance?
  inventory    InventoryItem[]
  saveOps      SaveOperation[]

  @@index([userId])
}

// Ngoại hình: CHỈ cosmetic (không ảnh hưởng chỉ số — xem src/sim/dog_archetype.hpp).
model CharacterAppearance {
  characterId String       @id @db.Uuid
  character   DogCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  coatColor   Int          @default(0)
  sizeVariant Float        @default(1.0)
  collar      String?
}

model InventoryItem {
  id          String       @id @default(uuid()) @db.Uuid
  characterId String       @db.Uuid
  character   DogCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  slot        Int
  itemId      String
  quantity    Int

  @@unique([characterId, slot])
}

// Idempotency cho lưu trạng thái: cùng (nhân vật, key) chỉ áp dụng một lần (game server gửi lại khi timeout).
model SaveOperation {
  id             String       @id @default(uuid()) @db.Uuid
  characterId    String       @db.Uuid
  character      DogCharacter @relation(fields: [characterId], references: [id], onDelete: Cascade)
  idempotencyKey String
  resultVersion  Int
  appliedAt      DateTime     @default(now())
  serverId       String

  @@unique([characterId, idempotencyKey])
}

model ServerInstance {
  id              String        @id
  region          String
  address         String
  port            Int
  capacity        Int
  currentPlayers  Int           @default(0)
  status          ServerStatus  @default(ONLINE)
  buildVersion    String
  lastHeartbeatAt DateTime      @default(now())
  sessions        GameSession[]
}

model GameSession {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId String         @db.Uuid
  serverId    String
  server      ServerInstance @relation(fields: [serverId], references: [id])
  ticketJti   String         @unique
  startedAt   DateTime       @default(now())
  endedAt     DateTime?
  endReason   String?

  @@index([userId])
}

// Bản ghi ticket đã cấp (jti một lần; game server cũng có replay cache riêng).
model SessionTicket {
  jti         String    @id
  userId      String    @db.Uuid
  characterId String    @db.Uuid
  serverId    String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  consumedAt  DateTime?
}

// Nhật ký kiểm toán: chỉ thêm. Không chứa mật khẩu/token.
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorType String
  actorId   String?
  action    String
  target    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([action])
}

// ============================================================================ Phase 12 — Xã hội
// Backend là nguồn sự thật cho quan hệ/thành viên/quyền. Client chỉ hiển thị.

enum FriendStatus {
  PENDING
  ACCEPTED
}

// Một hàng cho mỗi CẶP người dùng (pairKey = hai id sắp xếp) -> A gửi B và B gửi A đồng thời không tạo hai quan hệ.
model Friendship {
  id          String       @id @default(uuid()) @db.Uuid
  pairKey     String       @unique
  requesterId String       @db.Uuid
  requester   User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String       @db.Uuid
  addressee   User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      FriendStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  respondedAt DateTime?
  expiresAt   DateTime

  @@index([requesterId])
  @@index([addresseeId])
}

model UserBlock {
  blockerId String   @db.Uuid
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @db.Uuid
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

// Party/đàn tạm thời: đi cùng nhau, matchmaking xếp chung server.
model Party {
  id        String        @id @default(uuid()) @db.Uuid
  leaderId  String        @db.Uuid
  createdAt DateTime      @default(now())
  members   PartyMember[]
  invites   PartyInvite[]
}

model PartyMember {
  userId   String   @id @db.Uuid // mỗi người tối đa một party (khóa chính)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partyId  String   @db.Uuid
  party    Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@index([partyId])
}

// Chỉ một lời mời PENDING cho mỗi (party, người) — index một phần thêm bằng SQL trong migration.
model PartyInvite {
  id          String       @id @default(uuid()) @db.Uuid
  partyId     String       @db.Uuid
  party       Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  inviterId   String       @db.Uuid
  inviteeId   String       @db.Uuid
  status      InviteStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  @@index([inviteeId])
}

enum GuildRole {
  OWNER
  OFFICER
  MEMBER
}

enum GuildRequestKind {
  INVITE // bang mời người chơi
  JOIN // người chơi xin vào
}

model Guild {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  // Tên chuẩn hóa (chữ thường, gộp khoảng trắng) UNIQUE -> hai request tạo cùng tên đồng thời: DB chặn một cái.
  // Đặt NULL khi giải tán để tên được dùng lại.
  nameKey     String?        @unique
  description String         @default("")
  emblem      Int            @default(0)
  ownerId     String         @db.Uuid
  memberLimit Int
  createdAt   DateTime       @default(now())
  disbandedAt DateTime?
  members     GuildMember[]
  requests    GuildRequest[]
}

model GuildMember {
  userId   String    @id @db.Uuid // mỗi người tối đa một bang
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guildId  String    @db.Uuid
  guild    Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  role     GuildRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@index([guildId])
}

model GuildRequest {
  id          String           @id @default(uuid()) @db.Uuid
  guildId     String           @db.Uuid
  guild       Guild            @relation(fields: [guildId], references: [id], onDelete: Cascade)
  userId      String           @db.Uuid // người được mời / người xin vào
  actorId     String           @db.Uuid // người tạo yêu cầu
  kind        GuildRequestKind
  status      InviteStatus     @default(PENDING)
  createdAt   DateTime         @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  @@index([userId])
  @@index([guildId, status])
}

// Chat xã hội (global/party/guild). Chat gần (local) đi qua game server, không lưu.
model ChatMessage {
  id        BigInt   @id @default(autoincrement())
  channel   String // "global" | "party:<id>" | "guild:<id>"
  senderId  String   @db.Uuid
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([channel, id])
  @@index([senderId, createdAt])
}

// Thông báo/lời mời: dedupeKey chống tạo trùng (gửi lại request, double click).
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  payload   Json
  dedupeKey String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  readAt    DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

// ============================================================================ Phase 13 — Thanh toán (mock/sandbox) & kinh tế
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum EntitlementStatus {
  AVAILABLE
  CONSUMED
  REVOKED
}

// Số tiền/tiền tệ do SERVER quyết định theo purpose (data/economy/pricing.json), không bao giờ lấy từ client.
model PaymentOrder {
  id             String         @id @default(uuid()) @db.Uuid
  userId         String         @db.Uuid
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose        String // GUILD_CREATION
  amount         Int // VND (không có đơn vị lẻ)
  currency       String
  provider       String
  providerRef    String?
  checkoutUrl    String?
  idempotencyKey String
  status         PaymentStatus  @default(PENDING)
  expiresAt      DateTime
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  events         PaymentEvent[]
  entitlement    Entitlement?

  @@unique([userId, idempotencyKey])
  @@unique([provider, providerRef])
  @@index([status, expiresAt])
}

// Sổ cái sự kiện thanh toán: CHỈ THÊM (trigger DB chặn UPDATE/DELETE). Mọi webhook đều được ghi, kể cả bị từ chối.
model PaymentEvent {
  id              BigInt        @id @default(autoincrement())
  provider        String
  providerEventId String?
  orderId         String?       @db.Uuid
  order           PaymentOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  type            String
  amount          Int?
  currency        String?
  signatureValid  Boolean
  outcome         String // APPLIED | DUPLICATE | REJECTED_* | IGNORED_*
  payloadSha256   String
  receivedAt      DateTime      @default(now())

  @@unique([provider, providerEventId])
  @@index([orderId])
}

// Quyền (vd tạo một bang) sinh ra từ một order đã PAID — đúng một entitlement cho mỗi order.
model Entitlement {
  id         String            @id @default(uuid()) @db.Uuid
  userId     String            @db.Uuid
  user       User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind       String // GUILD_CREATION
  orderId    String            @unique @db.Uuid
  order      PaymentOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status     EntitlementStatus @default(AVAILABLE)
  guildId    String?           @unique @db.Uuid
  createdAt  DateTime          @default(now())
  consumedAt DateTime?

  @@index([userId, kind, status])
}

// Ví tiền TRONG GAME ("xương"): chỉ kiếm bằng chơi (game server báo), chỉ tiêu cho cosmetic. Không bán bằng tiền thật.
model Wallet {
  userId    String   @id @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Sổ giao dịch ví: chỉ thêm; refKey unique -> báo cộng tiền lặp (gửi lại) không cộng hai lần.
model CurrencyTx {
  id           BigInt   @id @default(autoincrement())
  userId       String   @db.Uuid
  delta        Int
  reason       String
  refKey       String   @unique
  balanceAfter Int
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model UserCosmetic {
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmeticId String
  acquiredAt DateTime @default(now())

  @@id([userId, cosmeticId])
}
